# Copy to .env and fill in. Never commit .env.
# All three keys can be the same OpenRouter key (sk-or-...): an OpenRouter key sends Jev and Claude calls through
# https://openrouter.ai/api automatically. TypeSafe or Anthropic keys go to those providers directly.

# Jev Ultrafast: Jev picks each browser action, a small OpenAI-compatible model writes typed text
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://openrouter.ai/api
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Claude: goal parsing, read-back summaries, lookup answers, /work checks
# (on OpenRouter, claude-sonnet-5-5 is sent as anthropic/claude-sonnet-5.5)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
READBACK_MODEL=claude-sonnet-5-5
WORK_MODEL=claude-sonnet-5-5

# Who "Sam" is. Comma-separated name=address pairs, throwaway addresses only.
DEMO_CONTACTS=Sam=sam.calhacks.demo@gmail.com

# Gmail: /mail/u/<index>/ of the demo account in the dedicated Chrome profile
GMAIL_ACCOUNT_INDEX=0
# Seconds of Gmail's "Undo send" window (Settings > General). Verification waits this out.
UNDO_SEND_S=5
# 1: after "cancel", open Sent and log a guard violation if the email is there (use for runs.py, not the demo)
VERIFY_CANCEL=
# 1: put To/Subject/Body in the compose URL and let the agent review it (fallback if typing the body fails)
GMAIL_PREFILL=

# Time budget for one /task (core gives up at 40 s)
TASK_BUDGET_S=32
# Extra guarded agent steps a lookup may take when the search page doesn't answer it
LOOKUP_MAX_STEPS=6

# 1: no Chrome, no keys. A scripted fake Gmail stands in for Jev Ultrafast (tests, core integration).
BROWSER_FAKE=
