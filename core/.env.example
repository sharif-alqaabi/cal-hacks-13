# Copy to .env and fill in. Never commit .env.

# Claude: vision (describe/signal) and low-confidence routing
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5
ROUTER_FALLBACK_MODEL=claude-sonnet-5-5

# Cartesia: Ink (STT) and Sonic (TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_STT_MODEL=ink-2
CARTESIA_TTS_MODEL=sonic-3.5
TTS_RATE=24000

# TypeSafe Jev router
TYPESAFE_API_KEY=
JEV_CONFIDENCE_THRESHOLD=0.6

# Teammate services: point at the test stubs in tests/stubs (default) or the real ones, no code change
MEMORY_URL=http://127.0.0.1:8001
BROWSER_URL=http://127.0.0.1:8002
SERVICE_TIMEOUT_S=4
INGEST_EVERY_S=3

# Local hazard loop
HAZARDS_ENABLED=true
YOLO_MODEL=yolov8n.pt
HAZARD_FPS=5
HAZARD_COOLDOWN_S=3
DEMO_MODE=false
