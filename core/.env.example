# Copy to .env and fill in. Never commit .env.

# Claude: vision (describe/signal) and low-confidence routing
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5
SIGNAL_MODEL=claude-haiku-5-5
ROUTER_FALLBACK_MODEL=claude-sonnet-5-5
ROUTER_FALLBACK_TIMEOUT_S=2
VISION_TIMEOUT_S=6

# Cartesia: Ink-2 (STT) and Sonic-3.5 (TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_VERSION=2026-08-14
CARTESIA_STT_MODEL=ink-2
CARTESIA_TTS_MODEL=sonic-3.5
STT_KEYTERMS=Sam,Palace of Fine Arts
TTS_RATE=24000
TTS_SPEED=1.75
# true: one say per sentence (phone queues them). false: join a reply into one say.
SAY_SPLIT=true

# TypeSafe Jev router
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=0.8
JEV_CONFIDENCE_THRESHOLD=0.6

# Teammate services: point at the test stubs in tests/stubs (default) or the real ones, no code change
MEMORY_URL=http://127.0.0.1:8001
BROWSER_URL=http://127.0.0.1:8002
SERVICE_TIMEOUT_S=4
INGEST_EVERY_S=3
SCENE_CHANGE_THRESHOLD=18

# Local hazard loop
HAZARDS_ENABLED=true
YOLO_MODEL=yolov8n.pt
HAZARD_FPS=15
HAZARD_COOLDOWN_S=10
HAZARD_PTT_MUTE_S=10
DEMO_MODE=false

# Mirror page
MIRROR_FRAME_FPS=15
