MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
SPACETIME_DB=calhacks13-memory
SPACETIME_TOKEN=
# SPACETIME_HOST=https://maincloud.spacetimedb.com

# Captioning (Haiku 5.5) and recall answers (Sonnet 5.5)
ANTHROPIC_API_KEY=
# CAPTION_MODEL=claude-haiku-5-5
# ANSWER_MODEL=claude-sonnet-5-5

# Where thumbnails are served from: the URL teammates and the dashboard can reach this service at
MEMORY_PUBLIC_URL=http://localhost:8001

# Test mode only (leave empty for real glasses frames)
# 1: read scene text from the JPEG comment mock/drive.py writes, instead of looking at pixels
MEMORY_TEST_SCENES=
# 1: enable POST /reset, which wipes the database (mock/drive.py seed uses it)
MEMORY_ALLOW_RESET=
